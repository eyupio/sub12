# Override the API base URL (defaults to https://sub12.io/api/v1 on native).
# VITE_API_URL=https://staging.sub12.io/api/v1

# Override the canonical site origin used for share links (defaults to https://sub12.io on native).
# VITE_SITE_URL=https://staging.sub12.io

# Set to "true" to enable Firebase Cloud Messaging push notifications on native.
# Requires a valid google-services.json at frontend/android/app/google-services.json
# (Android) and/or GoogleService-Info.plist (iOS), plus FCM_CREDENTIALS_JSON set
# on the backend. Without both pieces, calling register() crashes the JVM.
# VITE_FCM_ENABLED=true
