{
  "name": "sub12-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end Playwright tests for sub-12. Decoupled from the main app build.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:league": "playwright test tests/league",
    "test:event": "playwright test tests/event",
    "test:club": "playwright test tests/club",
    "codegen": "playwright codegen",
    "report": "playwright show-report",
    "install-browsers": "playwright install --with-deps",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "dotenv": "^18.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
