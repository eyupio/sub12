{
  "name": "sub12-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end Playwright tests for sub-12. Decoupled from the main app build.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:league": "playwright test tests/league",
    "test:event": "playwright test tests/event",
    "test:club": "playwright test tests/club",
    "codegen": "playwright codegen",
    "report": "playwright show-report",
    "install-browsers": "playwright install --with-deps",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
