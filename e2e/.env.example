# Copy to .env. Never commit .env.
#
# Where the suite points its browser. Default = local dev. CI overrides via secret.
BASE_URL=http://localhost:5173

# API base. Usually BASE_URL + /api/v1, but kept separate so local dev (Vite proxy)
# and direct staging (no proxy) both work.
API_URL=http://localhost:8080/api/v1

# User A: admin (used for league create + admin-delete cleanup).
USER_A_EMAIL=admin@sub12.local
USER_A_PASSWORD=password123

# User B: regular user (used as the joiner in lifecycle + non-owner in edge cases).
USER_B_EMAIL=userb@sub12.local
USER_B_PASSWORD=password123
