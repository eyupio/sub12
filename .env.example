# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sub12
DB_USER=sub12
DB_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=changeme-use-a-long-random-string-in-production
JWT_EXPIRY_HOURS=24

# Server
PORT=8080
ENV=development
CORS_ORIGIN=http://localhost:5173

# Public URLs (used in outgoing emails). SITE_URL is the canonical host;
# PASSWORD_RESET_URL and EVENT_INVITATION_URL are derived from it in code
# when left unset. Override SITE_URL for local dev so emailed links open
# the local Vite server. In production these MUST not contain localhost
# (the backend refuses to start if they do when ENV=production).
SITE_URL=http://localhost:5173
# PASSWORD_RESET_URL=http://localhost:5173/reset-password
# EVENT_INVITATION_URL=http://localhost:5173/events/invitations

# Reverse geocoding — turns a picked coordinate into a place name so cards
# read "Otley Sports Ground, Otley" instead of "53.862, -1.958". Any
# Nominatim-compatible endpoint works; set it empty to switch the lookup off
# (the UI then falls back to coordinates). GEOCODE_USER_AGENT identifies us to
# the endpoint as its usage policy requires; derived from SITE_URL when unset.
# GEOCODE_URL=https://nominatim.openstreetmap.org
# GEOCODE_USER_AGENT=sub12 (+https://sub12.io)

# Push notifications (Firebase Cloud Messaging, HTTP v1). Paste the full
# service-account JSON to enable push delivery. When unset, device tokens are
# stored but no push is sent (no-op sender).
# FCM_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}'
