<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static fallback sitemap for the standalone landing page. The deployed site
  serves a dynamic sitemap from the backend (GET /sitemap.xml), which also
  lists public /share/* entity URLs; this file only needs the fixed pages.

  Every <loc> must be reachable without signing in and must not be disallowed
  in robots.txt. /leagues, /clubs, /events, /help, /support and
  /feature-requests are authenticated in-app routes and are deliberately
  absent — listing them is what had Search Console reporting sitemap URLs as
  blocked or soft 404s.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://sub12.io/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://sub12.io/pellet-leaderboard</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://sub12.io/register</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://sub12.io/login</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://sub12.io/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://sub12.io/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://sub12.io/cookies</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
